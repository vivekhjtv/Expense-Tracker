# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200

# ---- MongoDB Atlas ----
# Must be a REPLICA SET (Atlas M0 free tier is one) — required for multi-document transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_tracker?retryWrites=true&w=majority

# ---- Google Gen AI (free key from https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
# 0 = thinking disabled (fastest + cheapest). -1 = dynamic. Or a token budget e.g. 512.
GEMINI_THINKING_BUDGET=0

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10

# ---- Single-user mode ----
# Until real auth is added, requests fall back to this userId (24-char hex ObjectId).
DEFAULT_USER_ID=000000000000000000000001
